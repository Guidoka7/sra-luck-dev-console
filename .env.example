# Dev Console · Supabase próprio
DEV_SUPABASE_URL=https://SEU-PROJETO.supabase.co
DEV_SUPABASE_ANON_KEY=
DEV_SUPABASE_SERVICE_ROLE_KEY=

# Assinatura da sessão própria do Dev Console (mínimo recomendado: 32 bytes aleatórios)
DEV_SESSION_SECRET=

# Conector com o sistema principal
SRA_LUCK_BASE_URL=https://sra-luck-react.vercel.app
SRA_LUCK_SERVICE_TOKEN=

# GitHub server-side (opcional nesta fase)
GITHUB_TOKEN=
GITHUB_REPOSITORY=Guidoka7/sra-luck-react

# Observabilidade de infraestrutura · Supabase do Sra Luck
# Token da Management API mantido somente no backend da Vercel.
SRA_SUPABASE_PROJECT_REF=
SRA_SUPABASE_ACCESS_TOKEN=

# Cloudflare Workers Analytics GraphQL
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_WORKER_SCRIPT=

# Vercel API (deploys do Dev Console ou projeto escolhido)
# Evitamos variáveis customizadas com prefixo VERCEL_.
DEV_VERCEL_ACCESS_TOKEN=
# Em produção, VERCEL_PROJECT_ID é fornecido pela própria Vercel.
# Use este fallback apenas fora da Vercel ou se necessário em ambiente local.
DEV_VERCEL_PROJECT_ID=
DEV_VERCEL_TEAM_ID=

# Autorização opcional para scheduler do Infrastructure Guardian
CRON_SECRET=

# Optional: Supabase Management API for infrastructure metrics of the Dev Console database
DEV_SUPABASE_PROJECT_REF=
DEV_SUPABASE_ACCESS_TOKEN=

# Optional: real memory limit of the Dev Console Vercel Function, for RSS alerts
DEV_FUNCTION_MEMORY_LIMIT_MB=
