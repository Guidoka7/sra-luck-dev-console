{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "functions": {
    "api/infra-scan.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/infra-scan",
      "schedule": "0 11 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/auth/login",
      "destination": "/api/auth-login"
    },
    {
      "source": "/api/auth/session",
      "destination": "/api/auth-session"
    },
    {
      "source": "/api/auth/logout",
      "destination": "/api/auth-logout"
    },
    {
      "source": "/api/auth/forgot",
      "destination": "/api/auth-forgot"
    },
    {
      "source": "/api/auth/reset",
      "destination": "/api/auth-reset"
    },
    {
      "source": "/api/dev-health",
      "destination": "/api/dev-ready?mode=health"
    },
    {
      "source": "/api/infra-cloudflare",
      "destination": "/api/infra-scan?mode=cloudflare"
    },
    {
      "source": "/api/infra-dev-supabase",
      "destination": "/api/infra-scan?mode=dev-supabase"
    },
    {
      "source": "/api/infra-history",
      "destination": "/api/infra-scan?mode=history"
    },
    {
      "source": "/api/infra-overview",
      "destination": "/api/infra-scan?mode=overview"
    },
    {
      "source": "/api/infra-runtime",
      "destination": "/api/infra-scan?mode=runtime"
    },
    {
      "source": "/api/infra-supabase",
      "destination": "/api/infra-scan?mode=supabase"
    },
    {
      "source": "/api/infra-vercel",
      "destination": "/api/infra-scan?mode=vercel"
    },
    {
      "source": "/api/problemas",
      "destination": "/api/infra-scan?mode=problems"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
